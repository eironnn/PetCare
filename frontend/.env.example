# Copy to .env.local and fill in. Never commit real secrets.
# Backend base URL (NestJS). The frontend calls ${NEXT_PUBLIC_API_URL}/auth/login etc.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Optional: Supabase (only needed if the frontend ever talks to Supabase directly;
# the plan is for all data to go through NestJS, keeping RLS/auth server-side).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
